# Copy this file to .env and adjust as needed. .env is gitignored.

# Postgres
POSTGRES_DB=hr_system
POSTGRES_USER=hr_admin
POSTGRES_PASSWORD=changeme_local_dev
POSTGRES_PORT=5432

# Host names for the datastores. Set to localhost for native local development;
# docker-compose.yml overrides these with the service names when running in
# containers, so these values only ever apply outside Compose.
DB_HOST=localhost
DB_PORT=5432
REDIS_HOST=localhost

# Where the Go backend reaches the Python face service. Native dev runs uvicorn
# directly on FACE_SERVICE_PORT; Compose maps that port to 8000 in the container.
FACE_SERVICE_URL=http://localhost:8001

# Redis
REDIS_PORT=6379

# Backend
BACKEND_PORT=8080

# Auth — change BOOTSTRAP_ADMIN_PASSWORD before any real/shared deployment
SESSION_TTL_HOURS=72
COOKIE_SECURE=false
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=changeme_admin_local

# Face service
FACE_SERVICE_PORT=8001

# Frontend
FRONTEND_PORT=3000
